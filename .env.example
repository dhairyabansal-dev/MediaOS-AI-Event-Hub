# Copy this file to .env and fill in real values. Never commit the real .env.

# Instagram login (accepted account-ban risk, for followee discovery).
# Strongly recommended: use a secondary/burner account, not a personal one.
INSTAGRAM_LOGIN_USERNAME=
INSTAGRAM_LOGIN_PASSWORD=

# Where instaloader's session file gets cached after first login
INSTAGRAM_SESSION_FILE=.instaloader_session

# Followee discovery controls
INSTAGRAM_DISCOVER_FOLLOWEES=true
INSTAGRAM_MAX_FOLLOWEES_PER_SEED=15
INSTAGRAM_DISCOVERY_REFRESH_HOURS=24
